---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="site-shell">
    <header class="topbar">
      <a class="brand" href="#home" aria-label="Ramesh Kumar Sah home"><span class="brand-mark">RS</span><span>Ramesh Kumar Sah</span></a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="#about">About</a><a href="#work">Work</a><a href="#experience">Experience</a><a href="#skills">Skills</a>
      </nav>
      <a class="nav-cta" href="#contact">Let’s talk <span>↗</span></a>
    </header>

    <section class="hero" id="home">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> SOFTWARE ENGINEER · KATHMANDU, NEPAL</div>
        <h1>Building software<br/>that <em>moves work forward.</em></h1>
        <p class="hero-lede">I’m Ramesh — a full-stack developer and project manager focused on SaaS products, business systems, AI-enabled applications, and cloud-native delivery.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore selected work <span>↘</span></a>
          <a class="button button-quiet" href="mailto:rsah3798@gmail.com">Get in touch <span>↗</span></a>
        </div>
        <div class="social-row">
          <a href="https://github.com/ramesh-sah" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/ramesh-kumar-sah-42b09b224/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          <a href="mailto:rsah3798@gmail.com">Email ↗</a>
        </div>
      </div>
      <div class="hero-visual" aria-label="Software engineering focus areas">
        <div class="visual-glow"></div>
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="core-card">
          <div class="core-top"><span class="tiny-label">CURRENT FOCUS</span><span class="live-pill">● BUILDING</span></div>
          <div class="core-symbol">⌘</div>
          <div class="core-title">Product engineering</div>
          <div class="core-subtitle">From architecture to deployment.</div>
          <div class="core-stack"><span>Python</span><span>Django</span><span>React</span><span>AWS</span></div>
        </div>
        <div class="float-chip chip-a"><span class="chip-icon">01</span><span><b>Full stack</b><small>Web & APIs</small></span></div>
        <div class="float-chip chip-b"><span class="chip-icon">02</span><span><b>AI & automation</b><small>LLMs · ML</small></span></div>
        <div class="float-chip chip-c"><span class="chip-icon">03</span><span><b>Cloud & DevOps</b><small>Deploy · Scale</small></span></div>
      </div>
      <div class="hero-foot"><span>SCROLL TO EXPLORE</span><span class="scroll-line"></span><span>01 / 05</span></div>
    </section>

    <section class="metrics-strip" aria-label="Professional highlights">
      <div><strong>5+</strong><span>Professional roles & internships</span></div>
      <div><strong>Full cycle</strong><span>Plan · Build · Test · Deliver</span></div>
      <div><strong>2:1</strong><span>UK honours degree classification</span></div>
      <div><strong>AWS</strong><span>Cloud learning & certification</span></div>
    </section>

    <section class="section about-section" id="about">
      <div class="section-kicker">01 — ABOUT</div>
      <div class="about-grid">
        <div><h2>Engineering with a<br/><em>product mindset.</em></h2></div>
        <div class="about-copy">
          <p class="large-copy">I turn business requirements into practical software — combining thoughtful architecture, clean implementation, and reliable delivery.</p>
          <p>I hold a BSc (Hons) in Computer Science and Software Engineering from Patan College for Professional Studies, affiliated with the University of Bedfordshire, UK. My experience spans full-stack development, ERP implementation, AI/ML exploration, and Agile project coordination.</p>
          <div class="about-tags"><span>Product thinking</span><span>System design</span><span>Agile delivery</span><span>Continuous learning</span></div>
        </div>
      </div>
    </section>

    <section class="section work-section" id="work">
      <div class="section-heading">
        <div><div class="section-kicker">02 — SELECTED WORK</div><h2>Projects with a<br/><em>purpose.</em></h2></div>
        <p>A selection of products and applications across SaaS, enterprise workflows, web platforms, and automation.</p>
      </div>
      <div class="project-grid">
        <article class="project-card project-featured">
          <div class="project-art art-blue"><div class="art-window"><div class="window-bar"><i></i><i></i><i></i><span>restromandu.com</span></div><div class="dash-layout"><div class="dash-side"></div><div class="dash-main"><div class="dash-head"></div><div class="dash-stats"><i></i><i></i><i></i></div><div class="dash-chart"></div></div></div></div><span class="art-index">01 / SAAS & ERP</span></div>
          <div class="project-info"><div class="project-meta"><span>IN-HOUSE PRODUCT · AIOT UNITECH</span><a href="https://restromandu.com" target="_blank" rel="noreferrer">↗</a></div><h3>RestroMandu</h3><p>Multi-tenant restaurant management SaaS bringing POS, orders, kitchen operations, inventory, procurement, and accounting into one platform.</p><div class="tech-list"><span>Django</span><span>DRF</span><span>PostgreSQL</span><span>Multi-tenancy</span></div><a class="text-link" href="https://restromandu.com" target="_blank" rel="noreferrer">Explore product <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-violet"><div class="art-browser"><div class="browser-top"></div><div class="mountain-shape"></div><div class="browser-lines"><i></i><i></i><i></i></div></div><span class="art-index">02 / TRAVEL</span></div>
          <div class="project-info"><div class="project-meta"><span>WEB PLATFORM</span><a href="https://treksadvisor.com" target="_blank" rel="noreferrer">↗</a></div><h3>TreksAdvisor</h3><p>Trekking and travel web platform built with a modern Astro-based frontend.</p><div class="tech-list"><span>Astro</span><span>Tailwind CSS</span><span>Node.js</span></div><a class="text-link" href="https://treksadvisor.com" target="_blank" rel="noreferrer">Visit website <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-slate"><div class="expedition-card"><span>HIMALAYAN EXPEDITIONS</span><b>EVEREST<br/>SUMMIT</b><small>Explore beyond limits</small></div><span class="art-index">03 / WEB PLATFORM</span></div>
          <div class="project-info"><div class="project-meta"><span>DJANGO APPLICATION</span><a href="https://mounteverest-summit.com" target="_blank" rel="noreferrer">↗</a></div><h3>Mount Everest Summit</h3><p>Expedition-focused web platform using Django, with a containerized deployment setup.</p><div class="tech-list"><span>Django</span><span>Docker</span><span>Nginx</span></div><a class="text-link" href="https://mounteverest-summit.com" target="_blank" rel="noreferrer">Visit website <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-cyan"><div class="news-layout"><div class="news-head">NEWS<span>LIVE</span></div><div class="news-feature"></div><div class="news-lines"><i></i><i></i><i></i></div></div><span class="art-index">04 / MEDIA</span></div>
          <div class="project-info"><div class="project-meta"><span>DIGITAL PUBLISHING</span><a href="https://nepalspeakslive.com.np" target="_blank" rel="noreferrer">↗</a></div><h3>Nepal Speaks Live</h3><p>Django-based digital media and publishing platform.</p><div class="tech-list"><span>Django</span><span>PostgreSQL</span><span>Redis</span></div><a class="text-link" href="https://nepalspeakslive.com.np" target="_blank" rel="noreferrer">Visit website <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-amber"><div class="flow-ui"><div class="flow-node">CONTACTS</div><div class="flow-arrow">↓</div><div class="flow-node flow-active">CAMPAIGN</div><div class="flow-arrow">↓</div><div class="flow-node">REPORTS</div></div><span class="art-index">05 / AUTOMATION</span></div>
          <div class="project-info"><div class="project-meta"><span>PYTHON DESKTOP APP</span><a href="https://github.com/ramesh-sah/WhatsFlowCampaignSuite" target="_blank" rel="noreferrer">↗</a></div><h3>WhatsFlow Campaign Suite</h3><p>WhatsApp campaign automation with contact import/export, reusable templates, media messaging, and progress tracking.</p><div class="tech-list"><span>Python</span><span>Automation</span><span>CSV</span></div><a class="text-link" href="https://github.com/ramesh-sah/WhatsFlowCampaignSuite" target="_blank" rel="noreferrer">View repository <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-green"><div class="property-ui"><div class="property-top"></div><div class="property-row"><i></i><i></i><i></i></div><div class="property-row"><i></i><i></i><i></i></div><div class="property-row"><i></i><i></i><i></i></div></div><span class="art-index">06 / BUSINESS SOFTWARE</span></div>
          <div class="project-info"><div class="project-meta"><span>WEB APPLICATION</span><a href="https://github.com/ramesh-sah/PropertyManagementSystem" target="_blank" rel="noreferrer">↗</a></div><h3>Property Management System</h3><p>Django application focused on property management workflows and structured business data.</p><div class="tech-list"><span>Python</span><span>Django</span><span>Database design</span></div><a class="text-link" href="https://github.com/ramesh-sah/PropertyManagementSystem" target="_blank" rel="noreferrer">View repository <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-pink"><div class="chain-ui"><span>CLIENT</span><b>↔</b><span>SMART CONTRACT</span><b>↔</b><span>FREELANCER</span></div><span class="art-index">07 / BLOCKCHAIN</span></div>
          <div class="project-info"><div class="project-meta"><span>UNDERGRADUATE THESIS</span><a href="https://github.com/ramesh-sah/freelancefusion" target="_blank" rel="noreferrer">↗</a></div><h3>FreelanceFusion</h3><p>Blockchain-integrated freelance platform exploring smart-contract payments and automated dispute resolution.</p><div class="tech-list"><span>Blockchain</span><span>Smart contracts</span><span>Full stack</span></div><a class="text-link" href="https://github.com/ramesh-sah/freelancefusion" target="_blank" rel="noreferrer">View repository <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-orange"><div class="inventory-ui"><div class="inventory-title">INVENTORY</div><div class="inventory-bars"><i></i><i></i><i></i><i></i></div><div class="inventory-foot">STOCK OVERVIEW</div></div><span class="art-index">08 / ERP WORKFLOWS</span></div>
          <div class="project-info"><div class="project-meta"><span>DJANGO REST APPLICATION</span><a href="https://github.com/ramesh-sah/InventoryKit" target="_blank" rel="noreferrer">↗</a></div><h3>InventoryKit</h3><p>Inventory management application built with Django REST Framework and token-based authentication.</p><div class="tech-list"><span>Django</span><span>DRF</span><span>JWT</span></div><a class="text-link" href="https://github.com/ramesh-sah/InventoryKit" target="_blank" rel="noreferrer">View repository <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-rose"><div class="media-ui"><span>SACHETANA</span><b>MEDIA</b><i></i><i></i></div><span class="art-index">09 / PUBLISHING</span></div>
          <div class="project-info"><div class="project-meta"><span>DJANGO WEBSITE</span><a href="https://sachetana_media.com" target="_blank" rel="noreferrer">↗</a></div><h3>Sachetana Media</h3><p>Django-based media and publishing website.</p><div class="tech-list"><span>Python</span><span>Django</span><span>CMS</span></div><a class="text-link" href="https://sachetana_media.com" target="_blank" rel="noreferrer">Visit website <b>↗</b></a></div>
        </article>
        <article class="project-card">
          <div class="project-art art-indigo"><div class="scrape-ui"><span>MAP DATA</span><div class="map-pins">⌖　⌖　⌖</div><div class="scrape-lines"><i></i><i></i><i></i></div></div><span class="art-index">10 / DATA AUTOMATION</span></div>
          <div class="project-info"><div class="project-meta"><span>PYTHON TOOLING</span><a href="https://github.com/ramesh-sah/Py-Lead-Generation-GoogleMaps-Data-Scraper" target="_blank" rel="noreferrer">↗</a></div><h3>Google Maps Lead Generation</h3><p>Python project for collecting and processing publicly available business information.</p><div class="tech-list"><span>Python</span><span>Web scraping</span><span>Data processing</span></div><a class="text-link" href="https://github.com/ramesh-sah/Py-Lead-Generation-GoogleMaps-Data-Scraper" target="_blank" rel="noreferrer">View repository <b>↗</b></a></div>
        </article>
      </div>
      <div class="work-footer"><span>More experiments, code, and contributions</span><a class="button button-outline" href="https://github.com/ramesh-sah" target="_blank" rel="noreferrer">Explore GitHub <span>↗</span></a></div>
    </section>

    <section class="section experience-section" id="experience">
      <div class="section-kicker">03 — EXPERIENCE</div>
      <div class="section-heading"><h2>Where I’ve<br/><em>made an impact.</em></h2><p>Experience across product delivery, ERP implementation, and full-stack engineering.</p></div>
      <div class="timeline">
        <article class="timeline-item"><div class="timeline-date">DEC 2025 — PRESENT</div><div class="timeline-body"><h3>Project Manager — Agile Project Management</h3><h4>AIOT Unitech Pvt. Ltd. · Lalitpur, Nepal</h4><p>Managing software projects end to end, leading the planning and delivery of RestroMandu, coordinating teams and stakeholders, and managing backlogs, sprints, risks, and delivery milestones using Trello and ClickUp.</p><div class="tech-list"><span>Agile</span><span>Product delivery</span><span>RestroMandu</span><span>Trello</span><span>ClickUp</span></div></div></article>
        <article class="timeline-item"><div class="timeline-date">NOV 2025 — PRESENT</div><div class="timeline-body"><h3>Part-Time Software Implementation Engineer — Retail ERP</h3><h4>Jubilant International · Kathmandu, Nepal</h4><p>Configuring retail ERP workflows across inventory, sales, purchasing, billing, and finance; supporting data migration, testing, user training, troubleshooting, and post-deployment improvements.</p><div class="tech-list"><span>ERP implementation</span><span>Data migration</span><span>Testing</span><span>Technical support</span></div></div></article>
        <article class="timeline-item"><div class="timeline-date">SEP 2024 — OCT 2025</div><div class="timeline-body"><h3>Full Stack Python Developer — React.js & Django</h3><h4>Kitwosd IT Support Center Pvt. Ltd. · Lalitpur, Nepal</h4><p>Developed Django and DRF APIs with React integrations, explored LLM and agent workflows, optimized application reliability, and worked with containerized deployments and CI/CD infrastructure.</p><div class="tech-list"><span>Python</span><span>Django REST Framework</span><span>React</span><span>Docker</span><span>AWS</span><span>Jenkins</span></div></div></article>
        <article class="timeline-item"><div class="timeline-date">MAY 2024 — AUG 2024</div><div class="timeline-body"><h3>Junior Software Developer — Internship</h3><h4>Patan College for Professional Studies · Lalitpur, Nepal</h4><p>Built full-stack applications using Laravel and React, developed REST APIs, and contributed to requirements analysis, database design, testing, and deployment.</p><div class="tech-list"><span>Laravel</span><span>React</span><span>REST APIs</span><span>SQL</span></div></div></article>
        <article class="timeline-item"><div class="timeline-date">JUN 2023 — APR 2024</div><div class="timeline-body"><h3>Python Full Stack Developer Intern — Django</h3><h4>Easy Software · Kathmandu, Nepal</h4><p>Developed full-stack web features using Python, Django, HTML, CSS, JavaScript, and React; built REST APIs and supported database design, testing, and debugging.</p><div class="tech-list"><span>Python</span><span>Django</span><span>React</span><span>JavaScript</span></div></div></article>
      </div>
    </section>

    <section class="section skills-section" id="skills">
      <div class="section-kicker">04 — TOOLKIT</div><div class="section-heading"><h2>Tools for the<br/><em>whole lifecycle.</em></h2><p>A practical mix of application engineering, data, AI, cloud infrastructure, and delivery tools.</p></div>
      <div class="skills-grid">
        <div class="skill-card"><span class="skill-number">01</span><h3>Languages</h3><p>Python · PHP · JavaScript · Java · C# · Dart · SQL</p></div>
        <div class="skill-card"><span class="skill-number">02</span><h3>Backend & APIs</h3><p>Django · Django REST Framework · FastAPI · Laravel</p></div>
        <div class="skill-card"><span class="skill-number">03</span><h3>Frontend & Mobile</h3><p>React.js · HTML5 · CSS3 · Bootstrap · Tailwind CSS · Flutter</p></div>
        <div class="skill-card"><span class="skill-number">04</span><h3>Data & Storage</h3><p>PostgreSQL · MySQL · Oracle · MongoDB · Redis</p></div>
        <div class="skill-card"><span class="skill-number">05</span><h3>AI / ML & GenAI</h3><p>TensorFlow · Keras · PyTorch · Scikit-learn · OpenCV · LangChain · LangGraph · Pydantic AI</p></div>
        <div class="skill-card"><span class="skill-number">06</span><h3>Cloud & DevOps</h3><p>AWS · Docker · Kubernetes · Jenkins · Terraform · Ansible · Nginx · Git</p></div>
        <div class="skill-card"><span class="skill-number">07</span><h3>Testing & Automation</h3><p>Pytest · Selenium · Postman · Scrapy · BeautifulSoup · Requests</p></div>
        <div class="skill-card"><span class="skill-number">08</span><h3>Architecture & Delivery</h3><p>System design · UML · Technical documentation · Figma · Agile · Jira</p></div>
      </div>
      <div class="cert-panel"><div><span class="section-kicker">CONTINUOUS LEARNING</span><h3>Cloud, AI, and delivery foundations.</h3></div><p>AWS Cloud Practitioner · AWS Academy / AWS Fundamentals · Python Essentials · JavaScript Essentials · Generative AI Fundamentals · Introduction to LLMs · Agile Project Management · CCNA Introduction to Networks</p></div>
    </section>

    <section class="education-band">
      <div><span class="section-kicker">EDUCATION</span><h2>BSc (Hons) Computer Science<br/>and Software Engineering</h2><p>Patan College for Professional Studies · Affiliated with the University of Bedfordshire, UK</p></div>
      <div class="education-result"><strong>2:1</strong><span>Upper Second Class Honours</span><small>2022 — 2025 · Nepal</small></div>
    </section>

    <section class="contact-section" id="contact">
      <div class="contact-orb"></div><div class="section-kicker">05 — CONTACT</div>
      <h2>Have a meaningful<br/><em>problem to solve?</em></h2>
      <p>I’m open to software engineering, full-stack development, ERP, and product-focused opportunities.</p>
      <div class="contact-actions"><a class="button button-primary" href="mailto:rsah3798@gmail.com?subject=Opportunity%20for%20Ramesh%20Kumar%20Sah">Email me <span>↗</span></a><a class="button button-light" href="https://www.linkedin.com/in/ramesh-kumar-sah-42b09b224/" target="_blank" rel="noreferrer">Connect on LinkedIn <span>↗</span></a></div>
      <div class="contact-details"><a href="mailto:rsah3798@gmail.com">rsah3798@gmail.com</a><a href="tel:+9779862981898">+977 9862981898</a><span>Kathmandu, Nepal</span></div>
    </section>
    <footer class="footer"><a class="brand" href="#home"><span class="brand-mark">RS</span><span>Ramesh Kumar Sah</span></a><span>Designed with intention. Built for what’s next.</span><span>© {new Date().getFullYear()} Ramesh Kumar Sah</span></footer>
  </main>
</Layout>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
